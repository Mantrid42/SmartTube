<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE: You can't set layout dimension for Presenter's container -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
             android:focusableInTouchMode="true"
             android:focusable="true"
             android:clipChildren="false"
             android:clipToPadding="false"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content">
    <LinearLayout
                  android:id="@+id/channel_card_wrapper"
                  android:orientation="horizontal"
                  android:layout_width="@dimen/channel_card_width"
                  android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="@dimen/channel_card_height"
            android:layout_height="@dimen/channel_card_height"
            android:layout_gravity="start|center_vertical">
            <ImageView
                android:id="@+id/channel_image"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible"
                tools:ignore="ContentDescription"/>
            <ProgressBar
                android:id="@+id/channel_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone"/>
            <ImageView
                android:id="@+id/channel_seen_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_channel_seen"
                android:visibility="gone"
                tools:ignore="ContentDescription"/>
        </FrameLayout>
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.MarqueeTextViewCompat
            android:id="@+id/channel_title"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/lb_basic_card_info_padding"
            android:textAlignment="textStart"/>
    </LinearLayout>
    <View
        android:id="@+id/channel_new_content_underline"
        android:layout_width="@dimen/channel_card_width"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:background="@color/search_opaque_yellow"
        android:visibility="gone"/>
</FrameLayout>
