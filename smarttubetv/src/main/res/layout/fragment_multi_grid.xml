<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:lb="http://schemas.android.com/apk/res-auto"
             android:id="@+id/browse_dummy"
             android:layout_width="match_parent"
             android:layout_height="match_parent" >

    <androidx.leanback.widget.BrowseFrameLayout
            android:id="@+id/grid_frame"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

        <!-- Place multiple grids horizontally -->
        <!--
        <LinearLayout
                android:id="@+id/browse_grid_dock"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        -->

        <!-- focusOutFront: allow navigating out from left side to the main menu. -->
        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/browse_grid_dock"
            lb:focusOutFront="true"
            lb:focusOutEnd="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.leanback.widget.BrowseFrameLayout>

    <LinearLayout
        android:id="@+id/channel_new_content_progress"
        android:layout_width="@dimen/channel_card_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@color/semi_transparent"
        android:orientation="vertical"
        android:paddingStart="@dimen/channel_new_content_progress_padding"
        android:paddingTop="@dimen/channel_new_content_progress_padding"
        android:paddingEnd="@dimen/channel_new_content_progress_padding"
        android:paddingBottom="@dimen/channel_new_content_progress_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/channel_new_content_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/channel_new_content_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/channel_new_content_progress_height"
            android:layout_marginTop="2dp"
            android:max="1"
            android:progress="0"
            android:progressDrawable="@drawable/channel_new_content_progress" />
    </LinearLayout>
</FrameLayout>
